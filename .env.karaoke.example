# Example settings for the score-only FastAPI container.
# Local preparation uses tools/prepare_song.py and auto-selects available hardware;
# it does not read this file or use dev/production profiles.
# API credentials must remain in your backend, never in the frontend.
AI_API_KEY=
AI_ENV=production
AI_DEVICE=cpu
# No mandatory RAM percentage. Leave AI_MEMORY_PERCENT unset.
AI_MAX_REQUEST_BYTES=134217728
AI_MAX_REFERENCE_BYTES=4194304
AI_MAX_DURATION_SECONDS=1800
AI_COMMAND_TIMEOUT_SECONDS=300
